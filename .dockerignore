# Keep the backend/frontend build contexts small. The backend and frontend images
# are built with context = repo root; exclude everything heavy or irrelevant.
**/.git
**/node_modules
**/venv
**/__pycache__
**/*.pyc
**/dist
**/.venv
frontend/dist
frontend/node_modules
frontend/.env
backend/venv
backend/.env
tests/node_modules
tests/test-results
tests/playwright-report
colmena-os
colmena-devops
terraform
.sj
*.log
