# Colmena docker compose — environment knobs.
# Every variable has a working default in docker-compose.yml, so `docker compose up`
# works with NO .env. Copy this to `.env` only to override. Never commit real secrets.

# --- Postgres ---
POSTGRES_HOSTNAME=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=colmena
POSTGRES_PASSWORD=colmena
POSTGRES_DATABASE=colmena_dev

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@colmena.local
PGADMIN_DEFAULT_PASSWORD=colmena

# --- Mailcrab (UI http://localhost:1080, SMTP :1025) ---
MAIL_UI_PORT=1080
MAIL_SMTP_PORT=1025

# --- Nextcloud (OCS http://localhost:8003, wrapper :8004) ---
NEXTCLOUD_VERSION=28.0.3
NEXTCLOUD_API_WRAPPER_PORT=5001
APACHE_APP_PATH=/var/www/nc_api_wrapper
NEXTCLOUD_PORT=8003
NEXTCLOUD_API_PORT=8004
# IMPORTANT: the colmena Nextcloud image stores this as a SINGLE trusted-domain entry
# (it does NOT split on commas), and auto-adds `localhost`. Set it to the ONE hostname
# the backend uses to reach Nextcloud — the compose service alias `nextcloud`. A comma
# list is stored verbatim as one bogus domain and breaks the backend's OCS calls (400).
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud
# NEXTCLOUD_ADMIN_USER must equal the backend superadmin username (seeded as `superadmin`).
NEXTCLOUD_ADMIN_USER=superadmin
NEXTCLOUD_ADMIN_PASSWORD=some-password

# --- Backend (API also reachable directly on http://localhost:8000) ---
BACKEND_PORT=8000
SUPERADMIN_EMAIL=superadmin@domain.org
SUPERADMIN_PASSWORD=some-password
# Single-host names used by load_sites_with_hostname (defaults suit localhost).
BACKEND_HOSTNAME=localhost:8000
FRONTEND_HOSTNAME=localhost

# --- Frontend (Vite dev, served via Caddy) ---
FRONTEND_PORT=5173

# --- Caddy (single host: SPA at /, API at /api/*) ---
# Default 8090/8443 (not 80/443) so it works under rootless Docker, which can't
# bind privileged ports. Change to 80/443 only if Docker runs as root.
HTTP_PORT=8090
HTTPS_PORT=8443
